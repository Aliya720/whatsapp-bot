# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=your-strong-db-password-here
DB_NAME=whatsapp_bot

# ─── App Environment ──────────────────────────────────────────────────────────
# "development" or "production"
ENVIRONMENT=production

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-very-long-random-secret-here

# ─── WhatsApp Sidecar ─────────────────────────────────────────────────────────
# Shared API key between the Python backend and the Node.js wa-sidecar service.
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
SIDECAR_API_KEY=your-sidecar-api-key-here

# ─── Provider Mode ────────────────────────────────────────────────────────────
# Set to "false" in production to use real WhatsApp connections.
# Set to "true" in development/testing to use mock providers (no sidecar needed).
USE_MOCK_PROVIDERS=false

# ─── Ports ────────────────────────────────────────────────────────────────────
# The port Nginx will listen on. Change to 80 for production.
HTTP_PORT=8080

# ─── Professional Mode (Meta Cloud API) ───────────────────────────────────────
# Only needed in development (production uses AWS Secrets Manager via the ARN).
META_ACCESS_TOKEN_DEV=

# ─── AWS (Production only — for Secrets Manager) ──────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
